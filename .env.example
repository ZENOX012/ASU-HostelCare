# ASU HostelCare Configuration
APP_NAME="ASU HostelCare"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Security & JWT
JWT_SECRET_KEY="asu_hostelcare_super_secret_production_key_change_me_in_prod"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL="sqlite:///./hostelcare.db"

# File Uploads
UPLOAD_DIR="./backend/uploads"
MAX_UPLOAD_SIZE_MB=5

# Rate Limiting (Requests per minute)
AUTH_RATE_LIMIT_PER_MINUTE=10
AUTH_MAX_FAILED_ATTEMPTS=5
PUBLIC_RATE_LIMIT_PER_MINUTE=30
USER_RATE_LIMIT_PER_MINUTE=120

# Admin Seed Account
SEED_ADMIN_EMAIL="admin@asu.edu"
SEED_ADMIN_PASSWORD="admin123"
SEED_ADMIN_NAME="Hostel Warden Office"
