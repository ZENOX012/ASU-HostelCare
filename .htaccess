# ==============================================================================
# ASU HostelCare — Apache / LiteSpeed / cPanel Security Rules
# Prevents unauthorized downloads, source-code leaks, directory browsing & zip steals
# ==============================================================================

# 1. Disable Directory Indexing (Prevents hackers from viewing folder contents)
Options -Indexes

# 2. Block access to hidden files and dotfiles (.env, .git, .htaccess, etc.)
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# 3. Block access to sensitive source code, database, archive and config files
<FilesMatch "\.(env|py|pyc|pyo|pyd|db|sqlite|sqlite3|sql|zip|tar|gz|rar|7z|bak|log|sh|bat|yaml|yml|md|txt)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# 4. Explicitly block internal backend and sensitive directories
RewriteEngine On
RewriteRule ^backend/.*$ - [F,L]
RewriteRule ^\.git/.*$ - [F,L]
RewriteRule ^data/.*$ - [F,L]
RewriteRule ^scratch/.*$ - [F,L]

# 5. Security Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
